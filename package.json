{
  "name": "weft",
  "version": "0.1.0",
  "private": true,
  "description": "Weft — a bilingual (EN/LT) fashion discovery and search MVP built with Next.js, TypeScript, an explainable concept-graph search, and Supabase/PostgreSQL analytics.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:locale": "python scripts/locale_e2e.py",
    "typecheck": "tsc --noEmit",
    "test:search": "node scripts/semantic-eval.mjs",
    "data:listings": "node scripts/generate-listings.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "lucide-react": "^1.17.0",
    "next": "^16.2.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
