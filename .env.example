NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Canonical public origin (e.g. https://weft.example) for the same-origin check on
# the analytics endpoints. When set, the Origin header is compared strictly
# against it and forwarded/host headers are ignored — set this in any real
# deployment. Leave unset locally to fall back to the request's own Host header.
# Do NOT set this in the CI/integration-smoke env unless it equals the smoke's
# own origin (http://127.0.0.1:3111), or same-origin POSTs there will 403.
APP_CANONICAL_ORIGIN=

# Set to "true" to render the cookie consent banner. Staged: it ships before
# the first real affiliate link, not after. See components/cookie-consent.tsx.
NEXT_PUBLIC_COOKIE_BANNER_ENABLED=
