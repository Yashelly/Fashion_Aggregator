NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only credential for automated `npm run search:index`.
# Create a dedicated sb_secret_ key in Supabase Settings -> API Keys.
SUPABASE_SECRET_KEY=
# Optional direct-Postgres fallback for local indexing.
# Prefer Supabase Connect -> Session pooler (port 5432) on IPv4 networks.
SUPABASE_DB_URL=

# Production hybrid search. This is server-only: never add NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional override; the production default is gemini-3.6-flash.
SEARCH_JUDGE_MODEL=

# Optional bake-off providers; `npm run eval:cloud` can compare them.
COHERE_API_KEY=
VOYAGE_API_KEY=

# Optional server-side analytics sink. Search does not require either value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Canonical public origin (e.g. https://weft.example) for the same-origin check on
# the analytics endpoints. When set, the Origin header is compared strictly
# against it and forwarded/host headers are ignored — set this in any real
# deployment. Leave unset locally to fall back to the request's own Host header.
# Do NOT set this in the CI/integration-smoke env unless it equals the smoke's
# own origin (http://127.0.0.1:3111), or same-origin POSTs there will 403.
APP_CANONICAL_ORIGIN=

# Set to "true" to render the cookie consent banner. Staged: it ships before
# the first real affiliate link, not after. See components/cookie-consent.tsx.
NEXT_PUBLIC_COOKIE_BANNER_ENABLED=
